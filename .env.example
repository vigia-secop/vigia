# Copia este archivo a .env y ajusta lo que necesites. .env no se versiona.

# Cadena de conexión a la base de datos donde vive la capa cruda.
# Sirve igual para un PostgreSQL instalado en la máquina que para el de
# docker-compose: los dos escuchan en localhost:5432 con el rol `vigia`.
VIGIA_DSN=postgresql://vigia:vigia@localhost:5432/vigia

# Base contra la que corren las pruebas de integración. Deliberadamente
# separada de VIGIA_DSN: esas pruebas BORRAN filas, y la capa cruda es una
# serie histórica que no se puede reconstruir a voluntad.
# VIGIA_DSN_PRUEBAS=postgresql://vigia:vigia@localhost:5432/vigia_pruebas

# Contraseña del contenedor de PostgreSQL de docker-compose. Solo la lee
# docker-compose; con PostgreSQL instalado en la máquina no hace nada.
POSTGRES_PASSWORD=vigia

# Dominio Socrata de la fuente. Solo se cambia para apuntar a un espejo o a pruebas.
VIGIA_DOMINIO_SOCRATA=https://www.datos.gov.co

# Registros por página. Socrata admite hasta 50000; 1000 es el valor por defecto de la API.
VIGIA_LIMITE_PAGINA=1000

# Días de solapamiento que cada Ciclo relee hacia atrás. El SECOP publica con
# retraso: sin ventana, un contrato firmado el día 1 y publicado el 12 se pierde
# para siempre. Si el Ciclo reporta VENTANA CORTA, súbela.
#
# Era 30 hasta el 2026-09-20. Se subió a 45 creyendo que se perdían contratos;
# medido después, no se perdía ninguno (cero nuevos con más de 30 días). Lo que
# sí gana la de 45 es ver las MODIFICACIONES que el SECOP hace a contratos de
# 31 a 46 días: 9.123 en una sola corrida. Cuesta ~50 % más de ingesta.
# La historia completa está junto a VENTANA_DIAS_POR_DEFECTO en vigia/__main__.py.
VIGIA_VENTANA_DIAS=45

# Nivel de registro: DEBUG, INFO, WARNING, ERROR.
VIGIA_LOG=INFO

# Token de aplicación de Socrata. Opcional: sin él la API funciona, pero con cuota
# compartida por IP. Con token la cuota es propia y más alta.
# VIGIA_TOKEN_SOCRATA=
